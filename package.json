{
  "name": "@dokove/labs",
  "version": "1.0.0",
  "description": "Proyectos de fin de etapa y laboratorios de ingeniería de software con taxonomías centralizadas Dokove.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./labs.json": "./dist/labs.json"
  },
  "files": [
    "dist",
    "labs",
    "README.md"
  ],
  "scripts": {
    "dev": "npm run build && vite",
    "build": "node scripts/build-labs-data.mjs",
    "validate:taxonomies": "node scripts/validate-taxonomies.mjs",
    "validate": "npm run validate:taxonomies",
    "test": "npm run build && npm run validate:taxonomies",
    "prepare": "git config core.hooksPath .githooks 2>/dev/null || true"
  },
  "dependencies": {
    "@dokove/taxonomies": "file:../taxonomies"
  },
  "devDependencies": {
    "@dokove/flexible-content": "file:../dokove.ui/packages/flexible-content",
    "@vitejs/plugin-react": "^6.1.1",
    "dokove-icons": "file:../dokove.ui/packages/icons",
    "dokove-labs": "file:../dokove.ui/packages/labs",
    "dokove-ui": "file:../dokove.ui/packages/ui",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-select": "^5.10.2",
    "vite": "^8.3.2"
  },
  "keywords": [
    "dokove",
    "labs",
    "capstone",
    "engineering-projects",
    "taxonomies",
    "architecture"
  ],
  "author": "Dokove Community",
  "license": "MIT"
}
